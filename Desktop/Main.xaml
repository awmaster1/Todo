<Window x:Class="Lab4.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToDo App" Height="600" Width="1000"
        Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANEL ===== -->
        <StackPanel Grid.Column="0" Background="White">

            <!-- Profile -->
            <StackPanel Margin="20" HorizontalAlignment="Center">
                <Ellipse Width="80" Height="80">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/123456.PNG"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="UserNameText" 
                           Text="Alex"
                           Margin="0,10,0,0"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Menu -->
            <StackPanel Margin="20,30,0,0">
                <TextBlock Text="Задачи" FontSize="14" Margin="0,10"/>
                <TextBlock Text="История" FontSize="14" Margin="0,10"/>
            </StackPanel>

            <!-- Add button -->
            <Button Content="+"
                    Width="84"
                    Height="50"
                    FontSize="24"
                    Background="#FF6B6B"
                    Foreground="White"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>
        </StackPanel>

        <!-- ===== CENTER PANEL ===== -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Categories -->
            <StackPanel Grid.Row="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">
                <TextBlock Text="Дом" 
                           Foreground="Green" 
                           Margin="10"
                           FontSize="14"
                           Cursor="Hand"
                           MouseLeftButtonDown="Category_Click"
                           Tag="Дом"/>
                <TextBlock Text="Работа" 
                           Foreground="Orange" 
                           Margin="10"
                           FontSize="14"
                           Cursor="Hand"
                           MouseLeftButtonDown="Category_Click"
                           Tag="Работа"/>
                <TextBlock Text="Учеба" 
                           Foreground="Blue" 
                           Margin="10"
                           FontSize="14"
                           Cursor="Hand"
                           MouseLeftButtonDown="Category_Click"
                           Tag="Учеба"/>
                <TextBlock Text="Отдых" 
                           Foreground="Purple" 
                           Margin="10"
                           FontSize="14"
                           Cursor="Hand"
                           MouseLeftButtonDown="Category_Click"
                           Tag="Отдых"/>
            </StackPanel>

            <!-- Task list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TasksList">
                    <!-- Tasks will be added dynamically -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== RIGHT PANEL ===== -->
        <Border Grid.Column="2"
                Margin="20"
                Padding="20"
                Background="White"
                CornerRadius="15">

            <StackPanel>
                <TextBlock x:Name="TaskTitle"
                           Text="Заголовок"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock x:Name="TaskTime"
                           Text="18:00"
                           Margin="0,10,0,0"/>
                <TextBlock x:Name="TaskDate"
                           Text="01 Января 2022"
                           Foreground="Gray"/>

                <TextBlock x:Name="TaskDescription"
                           Text="Lorem ipsum dolor sit amet, consectetur adipiscing."
                           Margin="0,20,0,0"
                           TextWrapping="Wrap"/>

                <Button x:Name="CompleteButton"
                        Content="Готово"
                        Margin="0,30,0,10"
                        Height="40"
                        Background="#FF6B6B"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CompleteButton_Click"
                        IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                             CornerRadius="15,15,3,3"
                             Background="{TemplateBinding Background}"
                             BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFD85050"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFC43C3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="DeleteButton"
                        Content="Удалить"
                        Height="40"
                        Background="#FF6B6B"
                        Foreground="White"
                        BorderThickness="0"
                        Click="DeleteButton_Click"
                        IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                CornerRadius="3,3,15,15"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFD85050"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFC43C3C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>