<Window x:Class="Desktop.CreateTask"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CreateTask" Height="535" Width="764">
    <Grid Width="764" Height="541">
        <!-- Поле для названия задачи -->
        <Label Content="Название" HorizontalAlignment="Left" Height="32" Margin="10,66,0,0" VerticalAlignment="Top" Width="111" FontSize="18"/>
        <Rectangle HorizontalAlignment="Left" Height="58" Margin="10,103,0,0" Stroke="Black" VerticalAlignment="Top" Width="342" RadiusX="15" RadiusY="15"/>
        <TextBox x:Name="TitleTextBox" HorizontalAlignment="Left" Height="50" Margin="15,108,0,0" VerticalAlignment="Top" Width="332" FontSize="18" BorderThickness="0" Background="Transparent"/>

        <!-- Поле для категории -->
        <Label Content="Категория" HorizontalAlignment="Left" Height="32" Margin="10,166,0,0" VerticalAlignment="Top" Width="111" FontSize="18"/>
        <Rectangle HorizontalAlignment="Left" Height="58" Margin="10,203,0,0" Stroke="Black" VerticalAlignment="Top" Width="342" RadiusX="15" RadiusY="15"/>
        <ComboBox x:Name="CategoryComboBox" HorizontalAlignment="Left" Height="50" Margin="15,208,0,0" VerticalAlignment="Top" Width="332" FontSize="18" BorderThickness="0" Background="Transparent">
            <ComboBoxItem Content="Дом"/>
            <ComboBoxItem Content="Работа"/>
            <ComboBoxItem Content="Учеба"/>
            <ComboBoxItem Content="Отдых"/>
        </ComboBox>

        <!-- Поле для описания -->
        <Label Content="Описание" HorizontalAlignment="Left" Height="30" Margin="10,261,0,0" VerticalAlignment="Top" Width="111" FontSize="18"/>
        <Rectangle HorizontalAlignment="Left" Height="103" Margin="10,296,0,0" Stroke="Black" VerticalAlignment="Top" Width="342" RadiusX="15" RadiusY="15"/>
        <TextBox x:Name="DescriptionTextBox" HorizontalAlignment="Left" Height="95" Margin="15,301,0,0" VerticalAlignment="Top" Width="332" FontSize="18" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True"/>

        <!-- Поле для времени -->
        <Label Content="Время" HorizontalAlignment="Left" Height="32" Margin="409,280,0,0" VerticalAlignment="Top" Width="111" FontSize="18"/>
        <Rectangle HorizontalAlignment="Left" Height="58" Margin="409,325,0,0" Stroke="Black" VerticalAlignment="Top" Width="300" RadiusX="15" RadiusY="15"/>
        <TextBox x:Name="TimeTextBox" HorizontalAlignment="Left" Height="50" Margin="415,330,0,0" VerticalAlignment="Top" Width="288" FontSize="18" BorderThickness="0" Background="Transparent" Text="9:00 am"/>

        <!-- Кнопки -->
        <Button x:Name="CreateButton" Content="Создать" HorizontalAlignment="Left" Margin="10,443,0,0" VerticalAlignment="Top" Width="327" Height="48" Background="#FF50AF54" Foreground="White" Click="Button_Click" FontSize="18">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="15" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button x:Name="CancelButton" Content="Отмена" HorizontalAlignment="Left" Margin="409,443,0,0" VerticalAlignment="Top" Width="327" Height="48" Background="#FFE04321" Foreground="White" Click="Button_Click_1" FontSize="18">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="15" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Препросмотр задачи (опционально) -->
        <Label Content="Предпросмотр задачи:" HorizontalAlignment="Left" Margin="409,66,0,0" VerticalAlignment="Top" FontSize="18" FontWeight="Bold"/>
        <Rectangle HorizontalAlignment="Left" Height="206" Margin="409,103,0,0" Stroke="Black" VerticalAlignment="Top" Width="300" RadiusX="15" RadiusY="15"/>
        <TextBlock x:Name="PreviewTextBlock" HorizontalAlignment="Left" Margin="415,110,0,0" VerticalAlignment="Top" Width="288" Height="190" FontSize="16" TextWrapping="Wrap"/>
    </Grid>
</Window>